  "helpTooltip": "Help & Guide",
  "helpTitle": "Fixed Width Record Inspector Guide",
  "helpProblemSolvedTitle": "Problem Solved",
  "helpProblemSolvedContent": "Inspects fixed-width positional text records (banking, EDI, mainframe exports) against column widths offline, detecting length discrepancies and boundary shifts.",
  "helpHowToUseTitle": "How to Use",
  "helpHowToUseContent": "Paste fixed-width records, input comma-separated field widths (e.g. 10, 5, 20), and tap Inspect records to view parsed fields and anomalies.",
  "helpReadingResultsTitle": "Reading Results",
  "helpReadingResultsContent": "Shows expected line length, total lines, compliant lines, interactive field-by-field previews, and flags rows that are too short or long.",
  "helpExampleTitle": "Example",
  "helpExampleContent": "Widths: \"5, 10\" (Expected length = 15)\nRow: \"12345ABCDEFGHIJ\" -> Field 1: \"12345\", Field 2: \"ABCDEFGHIJ\" (Valid 15 chars).",
  "helpLimitsTitle": "Validation & Limitations",
  "helpLimitsContent": "Positional column boundary inspector only. Does not validate business logic, bank clearing formats, or character encoding variations (EBCDIC).",
  "helpDataAndPrivacyTitle": "Local Data & Ads",
  "helpDataAndPrivacyContent": "All record text is parsed in-memory on your device without file system access or external uploads. An AdMob banner is displayed below."
